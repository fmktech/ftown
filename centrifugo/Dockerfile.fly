# Security release; pin the multi-platform manifest for reproducible builds.
FROM centrifugo/centrifugo:v6.10.2@sha256:34b84f823515927266ce3abfb840fd9e0acabb58805e7e896f5de731217a627d

COPY config.fly.json /centrifugo/config.fly.json
COPY --chmod=755 entrypoint.sh /centrifugo/entrypoint.sh
ENTRYPOINT ["/centrifugo/entrypoint.sh"]
CMD ["-c", "/centrifugo/config.fly.json"]
