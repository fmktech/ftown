{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@security/*": ["../bridge/src/security/*"],
      "@hpke/core": ["./node_modules/@hpke/core/esm/mod.d.ts"],
      "@hpke/common": ["./node_modules/@hpke/common/esm/mod.d.ts"],
      "zod": ["./node_modules/zod/index.d.cts"],
      "commander": ["./node_modules/commander/typings/index.d.ts"],
      "pg": ["./node_modules/@types/pg/index.d.ts"]
    },
    "forceConsistentCasingInFileNames": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
