# SECURITY: both secrets below MUST be at least 32 characters. The app fails
# fast (HTTP 500 / startup error) rather than signing tokens with a weak or
# absent secret — this applies in local dev too, so generate real values.
# Generate with: openssl rand -base64 48   (or: npx auth secret)
CENTRIFUGO_TOKEN_SECRET=your-centrifugo-token-secret-change-me-min-32-chars
NEXT_PUBLIC_CENTRIFUGO_URL=wss://your-centrifugo-host/connection/websocket

# Auth.js — minimum 32 characters (see note above)
AUTH_SECRET=your-auth-secret-generate-with-npx-auth-secret-min-32

# Public HTTPS origin of this deployment (the passkey origin). REQUIRED in
# production. Exact origin only: no trailing slash, path, credentials, query or
# fragment. A present empty/malformed value fails closed.
FTOWN_PUBLIC_URL=https://ftown.example.com
# Same origin, exposed to the browser.
NEXT_PUBLIC_FTOWN_PUBLIC_URL=https://ftown.example.com
# WebAuthn RP ID (the registrable domain of the origin, e.g. example.com).
NEXT_PUBLIC_FTOWN_RP_ID=ftown.example.com

# Database (PostgreSQL) holding the account ledger.
DATABASE_URL=postgresql://user:password@localhost:5432/ftown

# Account creation switch, read from the environment on each request (no
# rebuild). In production creation is open only when this is exactly "true";
# unset means closed. Outside production, unset means open.
REGISTRATION_ENABLED=true

# Optional limits on account creation. Plain positive integers; anything else
# uses the default shown.
# Soft cap on accounts on this server.
# FTOWN_MAX_ACCOUNTS=1000
# Creation attempts per client IP per hour.
# FTOWN_ACCOUNT_CREATE_PER_IP_HOUR=5
# Creation attempts per day across all clients.
# FTOWN_ACCOUNT_CREATE_GLOBAL_DAY=200
