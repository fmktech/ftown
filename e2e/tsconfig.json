{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../ui/src/*"],
      "@security/*": ["../bridge/src/security/*"]
    },
    "noEmit": true
  },
  "include": ["**/*.ts"]
}
