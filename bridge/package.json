{
  "name": "ftown-bridge",
  "version": "0.19.61",
  "description": "CLI bridge for ftown \u2014 generic PTY-over-Centrifugo relay",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ftown-bridge": "dist/index.js",
    "ftown": "dist/ftown-cli.js",
    "ftown-harness": "dist/harness-cli.js",
    "ftown-env": "dist/ftown-env-cli.js",
    "ftown-sessions": "bin/ftown-sessions",
    "ftown-mcp": "dist/mcp-cli.js"
  },
  "files": [
    "dist",
    "bin",
    "hooks",
    "pi-extension",
    "claude-mod",
    "opencode-plugin",
    "muse-plugin",
    "skills"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "prepublishOnly": "npm run build",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "harness": "tsx src/harness-cli.ts",
    "mcp": "tsx src/mcp-cli.ts"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "keywords": [
    "pty",
    "centrifugo",
    "orchestrator",
    "terminal",
    "bridge"
  ],
  "author": "fmktech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fmktech/ftown.git",
    "directory": "bridge"
  },
  "dependencies": {
    "@hpke/common": "1.10.1",
    "@hpke/core": "1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "centrifuge": "^5.2.2",
    "commander": "^13.1.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "node-datachannel": "^0.32.3",
    "node-pty": "^1.2.0-beta.12",
    "pg": "^8.23.1",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "ftownUpdateProtocol": 1,
  "overrides": {
    "qs": "6.16.1"
  }
}
